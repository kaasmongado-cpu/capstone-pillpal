# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# PostgreSQL (Neon DB)
DATABASE_URL="postgresql://user:password@your-neon-host/neondb?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:4000"
REQUIRE_EMAIL_VERIFICATION="true"

# Transactional Email Delivery (Priority: Resend -> Gmail SMTP -> Dev Console Log)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="PILLPAL CSU Infirmary <onboarding@resend.dev>"

# Optional Gmail SMTP Fallback (use a 16-character Google App Password)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your.email@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"

# Optional Future Google Sign-In (activates automatically when set)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional Gemini Vision OCR (activates structured multi-drug prescription & label OCR)
# GEMINI_API_KEY=""
# GEMINI_OCR_MODEL="gemini-2.5-flash"

# Portal URLs
VITE_API_URL="http://localhost:4000"
HEALTHCARE_WEB_URL="http://localhost:5174"
PATIENT_WEB_URL="http://localhost:5175"

# Mobile App API Endpoint (Use http://localhost:4000 for web/iOS simulator, http://10.0.2.2:4000 for Android emulator, or your LAN IP for physical device)
EXPO_PUBLIC_API_URL="http://localhost:4000"
