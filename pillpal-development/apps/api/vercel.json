{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run generate --workspace=@pillpal/database && npm run build --workspace=api",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "api/_app.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
