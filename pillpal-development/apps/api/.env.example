# PillPal API Environment Variables Template
# Copy to .env locally or set in Vercel Project Settings -> Environment Variables.

# PostgreSQL (Neon pooled connection string recommended for Vercel Serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DB_NAME?sslmode=require"

# Better Auth
BETTER_AUTH_URL="https://pillpal-api.vercel.app"
BETTER_AUTH_SECRET="replace-with-a-random-32-plus-character-secret"
REQUIRE_EMAIL_VERIFICATION="true"

# Deployed Frontend Portal URLs (used for CORS, email links, and OAuth redirects)
ADMIN_WEB_URL="https://pillpal-admin.vercel.app"
HEALTHCARE_WEB_URL="https://pillpal-healthcare.vercel.app"
PATIENT_WEB_URL="https://pillpal-patient.vercel.app"

# Optional: comma-separated extra CORS origins, or "true" to allow *.vercel.app preview deployments
CORS_ALLOWED_ORIGINS=""
ALLOW_VERCEL_PREVIEWS="false"

# Transactional Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="PILLPAL CSU Clinic <no-reply@yourdomain.com>"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini Vision OCR (recommended on Vercel Serverless)
GEMINI_API_KEY=""
GEMINI_OCR_MODEL="gemini-2.5-flash"
