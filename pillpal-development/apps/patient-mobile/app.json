{
  "expo": {
    "name": "PILLPAL Patient",
    "slug": "pillpal-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pillpal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.edu.carsu.pillpal.patient",
      "infoPlist": {
        "NSCameraUsageDescription": "PILLPAL needs camera access to scan physical medication labels and prescription slips.",
        "NSFaceIDUsageDescription": "PILLPAL uses Face ID for fast and secure access to your medical records."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ph.edu.carsu.pillpal.patient",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PILLPAL to access your camera to scan medicine bottles and prescription slips."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PILLPAL to access your photo library to upload prescription slips and medicine bottle photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10b981"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

